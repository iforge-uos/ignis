{
  "name": "Ignis",
  "dockerComposeFile": ["./docker-compose.yml"],
  "service": "workspace",
  "workspaceFolder": "/workspaces/ignis",
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  // Ports are published by docker-compose.yml, so VS Code mustn't forward them as well
  "portsAttributes": {
    "3000": { "label": "forge", "onAutoForward": "ignore" },
    "3001": { "label": "forge websocket", "onAutoForward": "ignore" },
    "4000": { "label": "mine", "onAutoForward": "ignore" },
    "10705": { "label": "gel", "onAutoForward": "ignore" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["biomejs.biome", "geldata.edgedb"]
    }
  }
}
